{
  "name": "emqnote",
  "version": "0.13.3",
  "private": true,
  "type": "module",
  "description": "Snelle notitie-app voor werk, met markdown-bestanden op OneDrive",
  "main": "out/main/index.js",
  "repository": "github:miel/emqnote",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run check:bundle",
    "start": "electron-vite preview",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "canonical": "tsx scripts/canonical.ts",
    "drive:capture": "tsx scripts/drive-capture.ts",
    "drive:library": "tsx scripts/drive-library.ts",
    "ui:kit": "tsx scripts/export-ui-kit.ts",
    "ui:deck": "python3 scripts/build-ui-deck.py",
    "icons": "tsx scripts/make-icons.ts"
  },
  "//dependencies": "Kept minimal on purpose. Main, preload and renderer are otherwise fully bundled, so nothing from node_modules is needed at runtime. Anything listed here is NOT bundled by electron-vite but externalised, and would then be missing from the package unless electron-builder ships it too (see the files list in electron-builder.yml). electron-updater is here because it does dynamic requires that don't survive bundling. If a native module is ever added (better-sqlite3 in phase 5) it belongs here as well.",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "chokidar": "^5.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "es-module-lexer": "^2.3.1",
    "jsdom": "^27.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "pdfjs-dist": "^6.2.108",
    "postal-mime": "^2.7.5",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "unified": "^11.0.5",
    "vitest": "^3.0.5",
    "yaml": "^2.7.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9"
  }
}
